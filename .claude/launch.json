{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tds2-workbench",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "tds2-storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "storybook",
        "--",
        "--no-open"
      ],
      "port": 6006,
      "autoPort": true
    }
  ]
}
